<Window x:Class="WinPaint.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WinPaint.App.Controls"
        xmlns:views="clr-namespace:WinPaint.App.Views"
        xmlns:conv="clr-namespace:WinPaint.App.Converters"
        xmlns:vm="clr-namespace:WinPaint.App.ViewModels"
        xmlns:res="clr-namespace:WinPaint.App.Resources"
        xmlns:svc="clr-namespace:WinPaint.App.Services"
        xmlns:tools="clr-namespace:WinPaint.Core.Tools;assembly=WinPaint.Core"
        xmlns:img="clr-namespace:WinPaint.Core.Imaging;assembly=WinPaint.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding Title}" Width="1280" Height="820" MinWidth="520" MinHeight="380"
        AutomationProperties.AutomationId="MainWindow"
        Background="{DynamicResource ChromeBackgroundBrush}"
        AllowDrop="True" UseLayoutRounding="True">
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEq" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:ColorToBrushConverter x:Key="ColorBrush" />
        <conv:EnumNameConverter x:Key="EnumName" />
        <conv:ShapeIconConverter x:Key="ShapeIcon" />
        <conv:BrushPreviewConverter x:Key="BrushPreview" />
        <conv:SizePreviewConverter x:Key="SizePreview" />
        <conv:FileNameConverter x:Key="FileName" />

        <ContextMenu x:Key="SelectionMenu" AutomationProperties.AutomationId="SelectionContextMenu">
            <MenuItem Header="{x:Static res:Strings.Edit_Cut}" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
            <MenuItem Header="{x:Static res:Strings.Edit_Copy}" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
            <MenuItem Header="{x:Static res:Strings.Edit_Paste}" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.Img_Crop}" Command="{Binding CropCommand}" InputGestureText="Ctrl+Shift+X" />
            <MenuItem Header="{x:Static res:Strings.Edit_SelectAll}" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
            <MenuItem Header="{x:Static res:Strings.Edit_InvertSelection}" Command="{Binding InvertSelectionCommand}" />
            <MenuItem Header="{x:Static res:Strings.Edit_Delete}" Command="{Binding DeleteCommand}" InputGestureText="Del" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.Img_Rotate}">
                <MenuItem Header="{x:Static res:Strings.Img_RotateRight}" Command="{Binding RotateCommand}" CommandParameter="{x:Static img:OrthoTransform.RotateRight}" />
                <MenuItem Header="{x:Static res:Strings.Img_RotateLeft}" Command="{Binding RotateCommand}" CommandParameter="{x:Static img:OrthoTransform.RotateLeft}" />
                <MenuItem Header="{x:Static res:Strings.Img_Rotate180}" Command="{Binding RotateCommand}" CommandParameter="{x:Static img:OrthoTransform.Rotate180}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Img_FlipVertical}" Command="{Binding RotateCommand}" CommandParameter="{x:Static img:OrthoTransform.FlipVertical}" />
            <MenuItem Header="{x:Static res:Strings.Img_FlipHorizontal}" Command="{Binding RotateCommand}" CommandParameter="{x:Static img:OrthoTransform.FlipHorizontal}" />
            <MenuItem Header="{x:Static res:Strings.Img_Resize}" Command="{Binding ResizeSkewCommand}" InputGestureText="Ctrl+W" />
            <MenuItem Header="{x:Static res:Strings.Img_InvertColors}" Command="{Binding InvertColorsCommand}" InputGestureText="Ctrl+Shift+I" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: menus, undo/redo, settings -->
        <Grid Grid.Row="0" Margin="4,2,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0" Background="Transparent" AutomationProperties.AutomationId="MainMenu">
                <MenuItem Header="{x:Static res:Strings.Menu_File}" AutomationProperties.AutomationId="FileMenu">
                    <MenuItem Header="{x:Static res:Strings.File_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" AutomationProperties.AutomationId="FileNew" />
                    <MenuItem Header="{x:Static res:Strings.File_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" AutomationProperties.AutomationId="FileOpen" />
                    <MenuItem Header="{x:Static res:Strings.File_Recent}" x:Name="RecentMenu" AutomationProperties.AutomationId="FileRecent" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.File_Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" AutomationProperties.AutomationId="FileSave" />
                    <MenuItem Header="{x:Static res:Strings.File_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="F12" AutomationProperties.AutomationId="FileSaveAs" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.File_Import}">
                        <MenuItem Header="{x:Static res:Strings.File_ImportFromFile}" Command="{Binding PasteFromCommand}" />
                    </MenuItem>
                    <MenuItem Header="{x:Static res:Strings.File_Print}">
                        <MenuItem Header="{x:Static res:Strings.File_PrintDots}" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
                        <MenuItem Header="{x:Static res:Strings.File_PageSetup}" Command="{Binding PageSetupCommand}" />
                        <MenuItem Header="{x:Static res:Strings.File_PrintPreview}" Command="{Binding PrintPreviewCommand}" />
                    </MenuItem>
                    <MenuItem Header="{x:Static res:Strings.File_SetDesktop}">
                        <MenuItem Header="{x:Static res:Strings.File_SetFill}" Command="{Binding SetDesktopCommand}" CommandParameter="{x:Static svc:WallpaperStyle.Fill}" />
                        <MenuItem Header="{x:Static res:Strings.File_SetTile}" Command="{Binding SetDesktopCommand}" CommandParameter="{x:Static svc:WallpaperStyle.Tile}" />
                        <MenuItem Header="{x:Static res:Strings.File_SetCenter}" Command="{Binding SetDesktopCommand}" CommandParameter="{x:Static svc:WallpaperStyle.Center}" />
                    </MenuItem>
                    <MenuItem Header="{x:Static res:Strings.File_Properties}" Command="{Binding ImagePropertiesCommand}" InputGestureText="Ctrl+E" AutomationProperties.AutomationId="FileProperties" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.File_Exit}" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.Menu_Edit}" AutomationProperties.AutomationId="EditMenu">
                    <MenuItem Header="{x:Static res:Strings.Edit_Undo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                    <MenuItem Header="{x:Static res:Strings.Edit_Redo}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.Edit_Cut}" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                    <MenuItem Header="{x:Static res:Strings.Edit_Copy}" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                    <MenuItem Header="{x:Static res:Strings.Edit_Paste}" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                    <MenuItem Header="{x:Static res:Strings.Edit_PasteFrom}" Command="{Binding PasteFromCommand}" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.Edit_SelectAll}" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
                    <MenuItem Header="{x:Static res:Strings.Edit_InvertSelection}" Command="{Binding InvertSelectionCommand}" />
                    <MenuItem Header="{x:Static res:Strings.Edit_Delete}" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                    <MenuItem Header="{x:Static res:Strings.Edit_Crop}" Command="{Binding CropCommand}" InputGestureText="Ctrl+Shift+X" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.Img_Resize}" Command="{Binding ResizeSkewCommand}" InputGestureText="Ctrl+W" />
                    <MenuItem Header="{x:Static res:Strings.Edit_InvertColors}" Command="{Binding InvertColorsCommand}" InputGestureText="Ctrl+Shift+I" />
                    <MenuItem Header="{x:Static res:Strings.Img_TransparentCanvas}" Command="{Binding ToggleTransparentCanvasCommand}" IsCheckable="False" IsChecked="{Binding IsTransparentCanvas, Mode=OneWay}" />
                    <MenuItem Header="{x:Static res:Strings.Layer_Flatten}" Command="{Binding Layers.FlattenCommand}" />
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.Menu_View}" AutomationProperties.AutomationId="ViewMenu">
                    <MenuItem Header="{x:Static res:Strings.View_Zoom}">
                        <MenuItem Header="{x:Static res:Strings.View_ZoomIn}" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl+PgUp" />
                        <MenuItem Header="{x:Static res:Strings.View_ZoomOut}" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+PgDn" />
                        <MenuItem Header="{x:Static res:Strings.View_Zoom100}" Command="{Binding ZoomActualCommand}" InputGestureText="Ctrl+1" />
                        <MenuItem Header="{x:Static res:Strings.View_ZoomFit}" Command="{Binding ZoomFitCommand}" InputGestureText="Ctrl+0" />
                        <Separator />
                        <MenuItem Header="12.5%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>0.125</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="25%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>0.25</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="50%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>0.5</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="100%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>1</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="200%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>2</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="300%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>3</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="400%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>4</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="500%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>5</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="600%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>6</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="700%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>7</sys:Double></MenuItem.CommandParameter></MenuItem>
                        <MenuItem Header="800%" Command="{Binding SetZoomPresetCommand}"><MenuItem.CommandParameter><sys:Double>8</sys:Double></MenuItem.CommandParameter></MenuItem>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.View_Rulers}" IsCheckable="True" IsChecked="{Binding ShowRulers}" InputGestureText="Ctrl+R" AutomationProperties.AutomationId="ViewRulers" />
                    <MenuItem Header="{x:Static res:Strings.View_Gridlines}" IsCheckable="True" IsChecked="{Binding ShowGridlines}" InputGestureText="Ctrl+G" AutomationProperties.AutomationId="ViewGridlines" />
                    <MenuItem Header="{x:Static res:Strings.View_StatusBar}" IsCheckable="True" IsChecked="{Binding ShowStatusBar}" />
                    <MenuItem Header="{x:Static res:Strings.View_Layers}" IsCheckable="True" IsChecked="{Binding ShowLayers}" />
                    <MenuItem Header="{x:Static res:Strings.View_Thumbnail}" IsCheckable="True" IsChecked="{Binding ShowThumbnail}" />
                    <MenuItem Header="{x:Static res:Strings.View_FullScreen}" Command="{Binding FullScreenCommand}" InputGestureText="F11" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.View_Theme}">
                        <MenuItem Header="{x:Static res:Strings.Theme_Light}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Light}" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Light, Mode=OneWay}" AutomationProperties.AutomationId="ThemeLight" />
                        <MenuItem Header="{x:Static res:Strings.Theme_Dark}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Dark}" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Dark, Mode=OneWay}" AutomationProperties.AutomationId="ThemeDark" />
                        <MenuItem Header="{x:Static res:Strings.Theme_System}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.System}" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=System, Mode=OneWay}" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.Menu_Help}">
                    <MenuItem Header="{x:Static res:Strings.Help_Shortcuts}" Command="{Binding ShowShortcutsCommand}" InputGestureText="F1" />
                    <MenuItem Header="{x:Static res:Strings.Help_About}" Command="{Binding ShowSettingsDialogCommand}" />
                </MenuItem>
            </Menu>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" AutomationProperties.AutomationId="UndoButton">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" AutomationProperties.AutomationId="RedoButton">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}" />
                </Button>
            </StackPanel>
            <Button Grid.Column="3" Style="{StaticResource ToolButton}" Command="{Binding ShowSettingsDialogCommand}" ToolTip="{x:Static res:Strings.Settings}" AutomationProperties.Name="{x:Static res:Strings.Settings}" AutomationProperties.AutomationId="SettingsButton">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Gear}" />
            </Button>
        </Grid>

        <!-- Toolbar strip -->
        <Border Grid.Row="1" Margin="6,2,6,4" Padding="6,2" CornerRadius="8" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
            <views:ToolbarView x:Name="Toolbar" />
        </Border>

        <!-- Contextual Text toolbar -->
        <Border Grid.Row="2" Margin="6,0,6,4" Padding="8,4" CornerRadius="8" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                Visibility="{Binding IsTextToolbarVisible, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="TextToolbar">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="190" IsEditable="True" ItemsSource="{Binding Source={x:Static vm:MainViewModel.FontFamilies}}" Text="{Binding TextFontFamily, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                          ToolTip="{x:Static res:Strings.Text_Font}" AutomationProperties.Name="{x:Static res:Strings.Text_Font}" AutomationProperties.AutomationId="FontFamilyBox" Focusable="True" IsTabStop="True" />
                <ComboBox Width="72" Margin="6,0,0,0" IsEditable="True" ItemsSource="{Binding Source={x:Static vm:MainViewModel.FontSizes}}" Text="{Binding TextFontSize, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                          ToolTip="{x:Static res:Strings.Text_Size}" AutomationProperties.Name="{x:Static res:Strings.Text_Size}" AutomationProperties.AutomationId="FontSizeBox" />
                <Border Style="{StaticResource GroupSeparator}" />
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding TextBold}" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="{x:Static res:Strings.Text_Bold}" AutomationProperties.AutomationId="BoldButton" Focusable="False">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Bold}" Width="14" Height="14" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding TextItalic}" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="{x:Static res:Strings.Text_Italic}" AutomationProperties.AutomationId="ItalicButton" Focusable="False">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Italic}" Width="14" Height="14" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding TextUnderline}" ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="{x:Static res:Strings.Text_Underline}" AutomationProperties.AutomationId="UnderlineButton" Focusable="False">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Underline}" Width="14" Height="14" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding TextStrikethrough}" ToolTip="{x:Static res:Strings.Text_Strikethrough}" AutomationProperties.Name="{x:Static res:Strings.Text_Strikethrough}" AutomationProperties.AutomationId="StrikeButton" Focusable="False">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Strike}" Width="14" Height="14" />
                </ToggleButton>
                <Border Style="{StaticResource GroupSeparator}" />
                <RadioButton Style="{StaticResource ToolRadio}" GroupName="TextBg" IsChecked="{Binding TextOpaque, Converter={StaticResource EnumEq}, ConverterParameter=False, Mode=OneWay}" Command="{Binding MakeTextTransparentCommand}"
                             ToolTip="{x:Static res:Strings.Text_Transparent}" AutomationProperties.Name="{x:Static res:Strings.Text_Transparent}" AutomationProperties.AutomationId="TextTransparentButton" Focusable="False">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.TextBgTransparent}" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolRadio}" GroupName="TextBg" IsChecked="{Binding TextOpaque, Mode=OneWay}" Command="{Binding MakeTextOpaqueCommand}"
                             ToolTip="{x:Static res:Strings.Text_Opaque}" AutomationProperties.Name="{x:Static res:Strings.Text_Opaque}" AutomationProperties.AutomationId="TextOpaqueButton" Focusable="False">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.TextBgOpaque}" />
                </RadioButton>
                <Border Style="{StaticResource GroupSeparator}" />
                <Ellipse Width="18" Height="18" Fill="{Binding PrimaryColor, Converter={StaticResource ColorBrush}}" Stroke="{DynamicResource SwatchBorderBrush}" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Text_Color}" />
                <Border Style="{StaticResource GroupSeparator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteTextCommand}" ToolTip="{x:Static res:Strings.Text_Delete}" AutomationProperties.Name="{x:Static res:Strings.Text_Delete}" AutomationProperties.AutomationId="DeleteTextButton" Focusable="False"
                        Visibility="{Binding TextSession, Converter={StaticResource NullVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Trash}" />
                        <TextBlock Text="{x:Static res:Strings.Text_Delete}" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Canvas + layers panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ctl:CanvasView x:Name="Canvas" Controller="{Binding}" Zoom="{Binding Zoom, Mode=TwoWay}" ShowRulers="{Binding ShowRulers}" ShowGridlines="{Binding ShowGridlines}" />
            <Border Grid.Column="1" Width="250" Margin="0,0,6,6" CornerRadius="8" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    Visibility="{Binding ShowLayers, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="LayersPanel">
                <views:LayersPanelView DataContext="{Binding Layers}" />
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Padding="10,3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="StatusBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CursorText}" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusCursor" />
                <TextBlock Grid.Column="1" Text="{Binding SelectionText}" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusSelection" />
                <TextBlock Grid.Column="2" Text="{Binding ImageSizeText}" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusImageSize" />
                <TextBlock Grid.Column="3" Text="{Binding FileSizeText}" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusFileSize" />
                <TextBlock Grid.Column="4" Text="{Binding StatusNotice}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StatusNotice" />
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <TextBox Width="62" Text="{Binding ZoomPercent, StringFormat={}{0:0.#}%, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Status_Zoom}"
                             AutomationProperties.Name="{x:Static res:Strings.Status_Zoom}" AutomationProperties.AutomationId="ZoomBox" KeyDown="OnZoomBoxKeyDown" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomOutCommand}" ToolTip="{x:Static res:Strings.Status_ZoomOut}" AutomationProperties.Name="{x:Static res:Strings.Status_ZoomOut}" AutomationProperties.AutomationId="ZoomOutButton" MinWidth="28" MinHeight="28">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Minus}" Width="12" Height="12" />
                    </Button>
                    <Slider Width="130" Minimum="1" Maximum="800" Value="{Binding ZoomPercent}" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Status_Zoom}" AutomationProperties.Name="{x:Static res:Strings.Status_Zoom}" AutomationProperties.AutomationId="ZoomSlider" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomInCommand}" ToolTip="{x:Static res:Strings.Status_ZoomIn}" AutomationProperties.Name="{x:Static res:Strings.Status_ZoomIn}" AutomationProperties.AutomationId="ZoomInButton" MinWidth="28" MinHeight="28">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomFitCommand}" ToolTip="{x:Static res:Strings.Status_Fit}" AutomationProperties.Name="{x:Static res:Strings.Status_Fit}" AutomationProperties.AutomationId="ZoomFitButton" MinWidth="28" MinHeight="28">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Fit}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
