<Window x:Class="WinPaint.App.Views.ImagePropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WinPaint.App.Resources"
        Title="{x:Static res:Strings.Dlg_ImageProperties}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="ImagePropertiesDialog">
    <StackPanel Margin="20" Width="360">
        <TextBlock Text="{x:Static res:Strings.Dlg_Attributes}" FontWeight="SemiBold" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static res:Strings.Dlg_LastSaved}" />
            <TextBlock Grid.Column="1" Text="{Binding LastSavedText}" AutomationProperties.AutomationId="LastSaved" />
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Dlg_SizeOnDisk}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeOnDiskText}" AutomationProperties.AutomationId="SizeOnDisk" />
            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Dlg_Resolution}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResolutionText}" AutomationProperties.AutomationId="Resolution" />
        </Grid>
        <TextBlock Text="{x:Static res:Strings.Dlg_Units}" FontWeight="SemiBold" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <RadioButton Content="{x:Static res:Strings.Dlg_Inches}" IsChecked="{Binding IsInches}" Margin="0,0,14,0" AutomationProperties.AutomationId="UnitInches" />
            <RadioButton Content="{x:Static res:Strings.Dlg_Centimeters}" IsChecked="{Binding IsCentimeters}" Margin="0,0,14,0" AutomationProperties.AutomationId="UnitCm" />
            <RadioButton Content="{x:Static res:Strings.Dlg_Pixels}" IsChecked="{Binding IsPixels}" AutomationProperties.AutomationId="UnitPixels" />
        </StackPanel>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label Content="{x:Static res:Strings.Dlg_Width}" Target="{Binding ElementName=W}" VerticalAlignment="Center" />
            <TextBox x:Name="W" Grid.Column="1" Text="{Binding WidthValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AutomationProperties.AutomationId="PropWidth" />
            <Label Grid.Row="1" Content="{x:Static res:Strings.Dlg_Height}" Target="{Binding ElementName=Ht}" VerticalAlignment="Center" />
            <TextBox x:Name="Ht" Grid.Row="1" Grid.Column="1" Text="{Binding HeightValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" AutomationProperties.AutomationId="PropHeight" />
        </Grid>
        <TextBlock Text="{x:Static res:Strings.Dlg_Colors}" FontWeight="SemiBold" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <RadioButton Content="{x:Static res:Strings.Dlg_BlackWhite}" IsChecked="{Binding BlackAndWhite}" Margin="0,0,14,0" AutomationProperties.AutomationId="ColorsBW" />
            <RadioButton Content="{x:Static res:Strings.Dlg_Color}" IsChecked="{Binding BlackAndWhite, Converter={StaticResource InvertBool}}" AutomationProperties.AutomationId="ColorsColor" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static res:Strings.Dlg_Default}" MinWidth="88" Click="OnDefault" />
            <Button Content="{x:Static res:Strings.OK}" IsDefault="True" MinWidth="88" Margin="8,0,0,0" Click="OnOk" AutomationProperties.AutomationId="OkButton" />
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" MinWidth="88" Margin="8,0,0,0" AutomationProperties.AutomationId="CancelButton" />
        </StackPanel>
    </StackPanel>
</Window>
