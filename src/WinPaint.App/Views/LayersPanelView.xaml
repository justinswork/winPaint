<UserControl x:Class="WinPaint.App.Views.LayersPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPaint.App.ViewModels"
             xmlns:res="clr-namespace:WinPaint.App.Resources"
             xmlns:conv="clr-namespace:WinPaint.App.Converters">
    <UserControl.Resources>
        <conv:EnumNameConverter x:Key="EnumName" />
    </UserControl.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Layer_Panel}" FontWeight="SemiBold" FontSize="14" Margin="2,0,0,8" />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Style="{StaticResource ToolButton}" Command="{Binding AddCommand}" ToolTip="{x:Static res:Strings.Layer_Add}" AutomationProperties.Name="{x:Static res:Strings.Layer_Add}" AutomationProperties.AutomationId="LayerAdd">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Plus}" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding DuplicateCommand}" ToolTip="{x:Static res:Strings.Layer_Duplicate}" AutomationProperties.Name="{x:Static res:Strings.Layer_Duplicate}" AutomationProperties.AutomationId="LayerDuplicate">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Duplicate}" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" ToolTip="{x:Static res:Strings.Layer_Delete}" AutomationProperties.Name="{x:Static res:Strings.Layer_Delete}" AutomationProperties.AutomationId="LayerDelete">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Trash}" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding MergeDownCommand}" ToolTip="{x:Static res:Strings.Layer_MergeDown}" AutomationProperties.Name="{x:Static res:Strings.Layer_MergeDown}" AutomationProperties.AutomationId="LayerMergeDown">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.MergeDown}" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding MoveUpCommand}" ToolTip="{x:Static res:Strings.Layer_MoveUp}" AutomationProperties.Name="{x:Static res:Strings.Layer_MoveUp}" AutomationProperties.AutomationId="LayerMoveUp">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ArrowUp}" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding MoveDownCommand}" ToolTip="{x:Static res:Strings.Layer_MoveDown}" AutomationProperties.Name="{x:Static res:Strings.Layer_MoveDown}" AutomationProperties.AutomationId="LayerMoveDown">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ArrowDown}" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding FlattenCommand}" ToolTip="{x:Static res:Strings.Layer_Flatten}" AutomationProperties.Name="{x:Static res:Strings.Layer_Flatten}" AutomationProperties.AutomationId="LayerFlatten">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Flatten}" />
            </Button>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="2,8,2,0" DataContext="{Binding Selected}">
            <TextBlock Text="{x:Static res:Strings.Layer_Opacity}" />
            <Slider Minimum="0" Maximum="100" Value="{Binding OpacityPercent, Delay=250}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{x:Static res:Strings.Layer_Opacity}" AutomationProperties.AutomationId="LayerOpacity" />
            <TextBlock Text="{x:Static res:Strings.Layer_BlendMode}" Margin="0,6,0,2" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:LayersViewModel.BlendModes}}" SelectedItem="{Binding BlendMode}" AutomationProperties.Name="{x:Static res:Strings.Layer_BlendMode}" AutomationProperties.AutomationId="LayerBlend">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumName}, ConverterParameter=Blend}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{x:Static res:Strings.Layer_Panel}" AutomationProperties.AutomationId="LayerList"
                 BorderThickness="0" Background="Transparent" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LayerItemViewModel}">
                    <Grid Margin="0,2" AutomationProperties.Name="{Binding Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="4" Background="White">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Text="{Binding TextCount, StringFormat={x:Static res:Strings.Layer_TextCount}}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Style="{StaticResource ToolToggle}" IsChecked="{Binding IsVisible}" ToolTip="{x:Static res:Strings.Layer_Visibility}"
                                      AutomationProperties.Name="{x:Static res:Strings.Layer_Visibility}" AutomationProperties.AutomationId="LayerVisibility" MinWidth="28" MinHeight="28">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Eye}" Width="16" Height="16" />
                        </ToggleButton>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
